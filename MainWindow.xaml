<Window x:Class="RaycastPM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RaycastPM.Models"
        Title="RaycastPM"
        Width="1120"
        Height="740"
        MinWidth="920"
        MinHeight="620"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="38" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="14,26,0,14" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
        </Style>

        <Style x:Key="LauncherToolResultButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#242424" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#303030" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1F1F1F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="LauncherTemplate">
            <Grid Background="{StaticResource PanelInsetBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#2B2B2B"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="28"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,2" />
                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding LauncherQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="20"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="搜索本机文件、文件夹、公式或美元"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LauncherQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#1E1E1E"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本机文件"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LauncherStatusText}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#181818"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding IsIndexingFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="24,10,24,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding IndexProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,7" />
                        <ProgressBar Grid.Row="1"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding IndexProgressValue, Mode=OneWay}"
                                     Background="#2C2C2C"
                                     Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="24,12,24,0"
                            Visibility="{Binding HasToolResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource LauncherToolResultButtonStyle}"
                            Command="{Binding CopyCalculatorResultCommand}"
                            Visibility="{Binding CurrencyResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="6"
                                    Background="#173D2E"
                                    BorderBrush="#286847"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="¥"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#89E0AC"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrencyResultText}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="点击复制换算结果"
                                           Style="{StaticResource ListMetaStyle}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="复制"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource LauncherToolResultButtonStyle}"
                            Command="{Binding CopyCalculatorResultCommand}"
                            Visibility="{Binding CalculatorResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="6"
                                    Background="#2D3555"
                                    BorderBrush="#4B5F9A"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="="
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#AFC3FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CalculatorResultText}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="点击复制计算结果"
                                           Style="{StaticResource ListMetaStyle}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="复制"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <ListBox Grid.Row="4"
                         ItemsSource="{Binding FilteredApps}"
                         SelectedItem="{Binding SelectedApp}"
                         MouseDoubleClick="AppsList_MouseDoubleClick"
                         Background="{StaticResource PanelInsetBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="62" Margin="24,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="#252525"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharacterConverter}}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Path, Converter={StaticResource FileIconToSourceConverter}}"
                                               Width="30"
                                               Height="30"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}"
                                               Style="{StaticResource ListMetaStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding LaunchCount, StringFormat={}{0} 次}"
                                               Style="{StaticResource ListMetaStyle}"
                                               HorizontalAlignment="Right"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Height="1"
                                        Background="#3A3A3A"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ClipboardTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource WindowChromeBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <Border Height="38"
                                Background="{StaticResource PanelInsetBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <Grid Margin="12,0">
                                <TextBox Text="{Binding ClipboardQuery, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0" />
                                <TextBlock Text="搜索剪贴板"
                                           FontSize="16"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClipboardQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding ClipboardTypeFilter, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  VerticalAlignment="Center"
                                  Margin="14,0,0,0">
                            <ComboBoxItem Content="全部类型" Tag="All" />
                            <ComboBoxItem Content="文本" Tag="Text" />
                            <ComboBoxItem Content="图片" Tag="Image" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Background="{StaticResource PanelInsetBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="剪贴板历史"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                        </Border>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding FilteredClipboardItems}"
                                     SelectedItem="{Binding SelectedClipboardEntry}"
                                     MouseDoubleClick="ClipboardList_MouseDoubleClick"
                                     Background="{StaticResource PanelInsetBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="74" Margin="14,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38"
                                                    Height="38"
                                                    Background="#2D2D30"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center">
                                                <Grid ClipToBounds="True">
                                                    <TextBlock Text="▤"
                                                               FontSize="20"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                                           Stretch="UniformToFill">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Column="1" Margin="0,0,14,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                </Grid.RowDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding KindTitle}"
                                                                   Style="{StaticResource ListMetaStyle}" />
                                                        <TextBlock Text=" · "
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="13" />
                                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                                   Style="{StaticResource ListMetaStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Row="1" Background="#3A3A3A" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="暂无记录"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilteredClipboardItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource BorderBrushSoft}" />

                    <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="24,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedClipboardEntry.DisplayText, TargetNullValue=剪贴板}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedClipboardEntry.KindTitle, TargetNullValue=未选择}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="复制"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding CopySelectedClipboardCommand}" />
                                    <Button Content="删除"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding DeleteSelectedClipboardCommand}"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="24">
                            <Border Background="{StaticResource PanelInsetBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBox Text="{Binding SelectedClipboardEntry.Content}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="17"
                                         Padding="18"
                                         VerticalContentAlignment="Top">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClipboardEntry}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedClipboardEntry.Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>

                            <Border Background="{StaticResource PanelInsetBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedClipboardEntry.Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding SelectedClipboardEntry.ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                       Stretch="Uniform"
                                       Margin="18" />
                            </Border>

                            <TextBlock Text="未选择项目"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedClipboardEntry}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NotesTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource WindowChromeBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="记事本"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedNote.Title, TargetNullValue=未选择记事}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="480" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="NotesHistoryButton"
                                          Content="历史记事"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          Margin="0,0,8,0" />
                            <TextBlock Text="字号"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
