                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <TextBlock Grid.Row="1" Text="硬盘索引" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Content="↻  重新扫描硬盘数据"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding RebuildFileIndexCommand}"
                                        HorizontalAlignment="Left" />
                                <Border Grid.Row="2" Grid.ColumnSpan="3" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Button Grid.Row="2" Content="↻  刷新汇率" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshRatesCommand}" Margin="14,0,0,0" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <TextBlock Text="剪贴板" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="文本" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="1" Text="图片" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="2" Text="文件" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="3" Text="链接" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="4" Text="颜色" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />

                                <ComboBox Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <TextBox Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="3" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="4" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />

                                <TextBlock Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="1" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Border Grid.Row="2" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Border Grid.Row="3" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Border Grid.Row="4" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="{x:Static models:SettingsPage.Usage}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="96" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="32,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="只显示使用次数大于 0 的应用"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="🗑  清除使用次数"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ClearUsageStatsCommand}"
                                    MinWidth="150"
                                    Height="36"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding UsageItems}"
                                 Background="{StaticResource PanelBrush}"
                                 BorderThickness="0"
                                 Padding="0,14,0,22"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="72" Margin="32,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="7"
                                                Background="#202020"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding Path, Converter={StaticResource FileIconToSourceConverter}}"
                                                   Width="30"
                                                   Height="30"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       Foreground="{StaticResource SettingsTextBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}"
                                                       Foreground="{StaticResource SettingsTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding LaunchCount, StringFormat={}{0} 次}"
                                                       Foreground="{StaticResource SettingsTextBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Height="1"
                                                Background="#383838"
                                                VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="还没有导航使用记录"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource WindowChromeBrush}"
                BorderBrush="#303030"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RaycastPM"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#181818"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsIndexingFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="18,8,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding IndexProgressText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,6" />
                <ProgressBar Grid.Row="1"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding IndexProgressValue, Mode=OneWay}"
                             Background="#2C2C2C"
                             Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:AppSection.Launcher}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LauncherTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:AppSection.Clipboard}">
                                <Setter Property="ContentTemplate" Value="{StaticResource ClipboardTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:AppSection.Notes}">
                                <Setter Property="ContentTemplate" Value="{StaticResource NotesTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Window>
