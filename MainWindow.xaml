                                <Border Grid.Row="3" Grid.Column="1" Height="38" Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.SettingsHotKey}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Row="3" Grid.Column="2" Content="↻" Style="{StaticResource IconButtonStyle}" />
                                <Button Grid.Row="3" Grid.Column="4" Content="▣  打开" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ShowSettingsCommand}" />
                            </Grid>
