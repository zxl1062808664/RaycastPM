                                     Height="32"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0" />
                            <Button Content="+  新建"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding AddNoteCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="删除"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding DeleteSelectedNoteCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Popup x:Name="NotesHistoryPopup"
                           PlacementTarget="{Binding ElementName=NotesHistoryButton}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           IsOpen="{Binding IsChecked, ElementName=NotesHistoryButton, Mode=TwoWay}">
                        <Border Width="380"
                                Height="480"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1"
                                        Background="{StaticResource WindowChromeBrush}">
                                    <Grid Margin="16,0">
                                        <TextBox Text="{Binding NoteQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"
                                                 FontSize="15"
                                                 Padding="12,0"
                                                 VerticalContentAlignment="Center" />
                                        <TextBlock Text="搜索记事"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="13,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoteQuery}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding FilteredNotes}"
                                         SelectedItem="{Binding SelectedNote}"
                                         SelectionChanged="NotesHistoryList_SelectionChanged"
                                         Tag="{Binding ElementName=NotesHistoryPopup}"
                                         Background="{StaticResource PanelBrush}"
                                         BorderThickness="0"
                                         Padding="0,8,0,12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="66" Margin="16,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center"
                                                                Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Body}"
                                                                   Style="{StaticResource ListMetaStyle}"
                                                                   MaxHeight="18"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                               Style="{StaticResource ListMetaStyle}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Border Grid.Row="1" Background="#383838" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>

                    <Grid Background="{StaticResource PanelInsetBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,16,18,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBox Text="{Binding NewNoteTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         FontSize="15"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="新记事标题"
                                           FontSize="15"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="13,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewNoteTitle}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBox Text="{Binding NoteQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         FontSize="15"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="搜索记事"
                                           FontSize="15"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="13,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoteQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredNotes}"
                                 SelectedItem="{Binding SelectedNote}"
                                 Background="{StaticResource PanelInsetBrush}"
                                 BorderThickness="0"
                                 Padding="0,4,0,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="68" Margin="18,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Body}"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       MaxHeight="18"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   VerticalAlignment="Center" />
                                        <Border Height="1"
                                                Background="#3A3A3A"
                                                VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource BorderBrushSoft}" />

                    <Grid Grid.Column="2">
                        <Grid Margin="46,34,46,40">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNote}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="28"
                                     FontWeight="SemiBold"
                                     Padding="0"
                                     VerticalContentAlignment="Center" />
                            <TextBox Grid.Row="2"
                                     Text="{Binding SelectedNote.Body, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="{Binding NoteFontSize}"
                                     Padding="0"
                                     VerticalContentAlignment="Top" />
                            <TextBlock Grid.Row="3"
                                       Text="{Binding SelectedNote.UpdatedAt, StringFormat=最后更新 {0:yyyy-MM-dd HH:mm}}"
                                       Style="{StaticResource ListMetaStyle}"
                                       VerticalAlignment="Bottom" />
                        </Grid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNote}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="还没有选择记事"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="点击新建开始记录"
                                       Style="{StaticResource ListMetaStyle}"
                                       FontSize="15"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SettingsTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFFFFF" />

                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                    </Style>

                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                    </Style>

                    <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                        <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Root"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#3A3A3A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ComboBox">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                        <Setter Property="Background" Value="#000000" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid SnapsToDevicePixels="True">
                                        <ToggleButton x:Name="ToggleButton"
                                                      Focusable="False"
                                                      ClickMode="Press"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Root"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                            CornerRadius="4">
                                                        <TextBlock Text="⌄"
                                                                   Foreground="{StaticResource SettingsTextBrush}"
                                                                   FontSize="16"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,1" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#6A6A6A" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="#080808" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <ContentPresenter Margin="10,0,30,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                                        <Popup x:Name="PART_Popup"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               IsOpen="{TemplateBinding IsDropDownOpen}">
                                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Background="{StaticResource PanelInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <ScrollViewer CanContentScroll="True"
                                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Border Style="{StaticResource SegmentBoxStyle}"
                            Width="390"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <UniformGrid Columns="2" Margin="2">
                            <RadioButton Content="设置"
                                         GroupName="SettingsSections"
                                         Style="{StaticResource NavTabStyle}"
                                         Foreground="{StaticResource SettingsTextBrush}"
                                         Command="{Binding ShowSettingsGeneralCommand}"
                                         IsChecked="{Binding SelectedSettingsPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:SettingsPage.General}}" />
                            <RadioButton Content="使用次数"
                                         GroupName="SettingsSections"
                                         Style="{StaticResource NavTabStyle}"
                                         Foreground="{StaticResource SettingsTextBrush}"
                                         Command="{Binding ShowUsageStatsCommand}"
                                         IsChecked="{Binding SelectedSettingsPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:SettingsPage.Usage}}" />
                        </UniformGrid>
                    </Border>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="{x:Static models:SettingsPage.General}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="860"
                                Margin="0,28,0,56">
                        <TextBlock Text="系统" Style="{StaticResource SectionTitleStyle}" />
