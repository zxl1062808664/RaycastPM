                                <TextBlock Grid.Row="1" Text="剪贴板" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Border Grid.Row="1" Grid.Column="1" Height="38" Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.ClipboardHotKey}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Row="1" Grid.Column="2" Content="↻" Style="{StaticResource IconButtonStyle}" />
                                <Button Grid.Row="1" Grid.Column="4" Content="▣  打开" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ShowClipboardCommand}" />

                                <Border Grid.Row="2" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <TextBlock Grid.Row="2" Text="记事本" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Border Grid.Row="2" Grid.Column="1" Height="38" Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.NotesHotKey}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Row="2" Grid.Column="2" Content="↻" Style="{StaticResource IconButtonStyle}" />
                                <Button Grid.Row="2" Grid.Column="4" Content="▣  打开" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ShowNotesCommand}" />

