<Window x:Class="RaycastPM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RaycastPM.Models"
        Title="RaycastPM"
        Width="1120"
        Height="740"
        MinWidth="920"
        MinHeight="620"
        Background="{StaticResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#252525" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Height" Value="38" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="14,26,0,14" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
        </Style>

        <Style x:Key="LauncherToolResultButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#242424" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#303030" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1F1F1F" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#3A3A3A" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#454545" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotKeyToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggleButtonStyle}">
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="ListMetaStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PlanTimeComboBoxTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style x:Key="PlanComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#243244" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanTimeComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="#333333" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource PlanComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  Margin="10,0,0,0"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left" />
                                <TextBox x:Name="PART_EditableTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource PlanTimeComboBoxTextBoxStyle}"
                                         Margin="10,0,4,0"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{StaticResource AccentBrush}"
                                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                         VerticalContentAlignment="Center"
                                         Visibility="Collapsed" />
                                <TextBlock Grid.Column="1"
                                           Text="▼"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                            </Grid>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Opacity="0" />
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource PanelRaisedBrush}"
                                        BorderBrush="{StaticResource BorderBrushStrong}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260">
                                    <ScrollViewer CanContentScroll="True"
                                                  Padding="4">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanDatePickerTextBoxStyle"
               TargetType="DatePickerTextBox"
               BasedOn="{StaticResource {x:Type DatePickerTextBox}}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentElement"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                                <ContentControl x:Name="PART_Watermark"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                IsHitTestVisible="False"
                                                Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="112" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CalendarStyle" Value="{DynamicResource PlanCalendarStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="PART_Root"
                              SnapsToDevicePixels="True">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Style="{StaticResource PlanDatePickerTextBoxStyle}"
                                                   Margin="10,0,4,0"
                                                   VerticalContentAlignment="Center" />
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0">
                                    <TextBlock Text="▼"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Background="#16212C"
                                        BorderBrush="#243244"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="8">
                                    <Calendar Style="{DynamicResource PlanCalendarStyle}" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanCalendarItemStyle" TargetType="CalendarItem">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="PlanCalendarButtonStyle" TargetType="CalendarButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <Style x:Key="PlanCalendarDayButtonStyle" TargetType="CalendarDayButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#363636" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsToday" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsInactive" Value="True">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
                <Trigger Property="IsBlackedOut" Value="True">
                    <Setter Property="Opacity" Value="0.25" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanCalendarStyle" TargetType="Calendar" BasedOn="{StaticResource {x:Type Calendar}}">
            <Setter Property="Background" Value="{StaticResource PanelRaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CalendarItemStyle" Value="{StaticResource PlanCalendarItemStyle}" />
            <Setter Property="CalendarButtonStyle" Value="{StaticResource PlanCalendarButtonStyle}" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource PlanCalendarDayButtonStyle}" />
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#16212C" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#16212C" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#243244" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#243244" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F4F7FB" />
                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7F8A99" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C88752" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F1722" />
            </Style.Resources>
        </Style>

        <Style x:Key="PlanCalendarScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Panel.ZIndex" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlanCalendarScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="4" />
            <Setter Property="MinWidth" Value="4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Opacity" Value="0.2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource PlanCalendarScrollBarThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95" />
                                <Setter TargetName="PART_Track" Property="Thumb.Style">
                                    <Setter.Value>
                                        <Style TargetType="Thumb" BasedOn="{StaticResource PlanCalendarScrollBarThumb}">
                                            <Setter Property="Background" Value="#4DFFFFFF" />
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="4" />
                    <Setter Property="MinHeight" Value="4" />
                    <Setter Property="MinWidth" Value="0" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlanCalendarScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Row="0"
                                                    Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Style="{StaticResource PlanCalendarScrollBar}"
                                       Margin="10,2,0,2"
                                       HorizontalAlignment="Right"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       Style="{StaticResource PlanCalendarScrollBar}"
                                       Margin="2,10,12,0"
                                       VerticalAlignment="Bottom"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LauncherTemplate">
            <Grid Background="{StaticResource PanelInsetBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="#2B2B2B"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="28"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,2" />
                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding LauncherQuery, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="20"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     VerticalContentAlignment="Center" />
                            <TextBlock Text="搜索本机文件、文件夹、公式或美元"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LauncherQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="#1E1E1E"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本机文件"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding LauncherStatusText}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="#181818"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding IsIndexingFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="24,10,24,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding IndexProgressText}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,7" />
                        <ProgressBar Grid.Row="1"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding IndexProgressValue, Mode=OneWay}"
                                     Background="#2C2C2C"
                                     Foreground="{StaticResource AccentBrush}"
                                     BorderThickness="0" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3"
                            Margin="24,12,24,0"
                            Visibility="{Binding HasToolResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Style="{StaticResource LauncherToolResultButtonStyle}"
                            Command="{Binding CopyCalculatorResultCommand}"
                            Visibility="{Binding CurrencyResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="6"
                                    Background="#173D2E"
                                    BorderBrush="#286847"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="¥"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#89E0AC"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrencyResultText}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="点击复制换算结果"
                                           Style="{StaticResource ListMetaStyle}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="复制"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource LauncherToolResultButtonStyle}"
                            Command="{Binding CopyCalculatorResultCommand}"
                            Visibility="{Binding CalculatorResult, Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    CornerRadius="6"
                                    Background="#2D3555"
                                    BorderBrush="#4B5F9A"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="="
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#AFC3FF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding CalculatorResultText}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="点击复制计算结果"
                                           Style="{StaticResource ListMetaStyle}"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       Text="复制"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Margin="16,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>

                <ListBox Grid.Row="4"
                         ItemsSource="{Binding FilteredApps}"
                         SelectedItem="{Binding SelectedApp}"
                         MouseDoubleClick="AppsList_MouseDoubleClick"
                         Background="{StaticResource PanelInsetBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="62" Margin="24,0,24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="#252525"
                                        BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource FirstCharacterConverter}}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding Path, Converter={StaticResource FileIconToSourceConverter}}"
                                               Width="30"
                                               Height="30"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}"
                                               Style="{StaticResource ListMetaStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding LaunchCount, StringFormat={}{0} 次}"
                                               Style="{StaticResource ListMetaStyle}"
                                               HorizontalAlignment="Right"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Height="1"
                                        Background="#3A3A3A"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ClipboardTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource WindowChromeBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Border Height="38"
                                Background="{StaticResource PanelInsetBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="4"
                                VerticalAlignment="Center">
                            <Grid Margin="12,0">
                                <TextBox Text="{Binding ClipboardQuery, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="16"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Padding="0" />
                                <TextBlock Text="搜索剪贴板"
                                           FontSize="16"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ClipboardQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ComboBox Grid.Column="1"
                                  SelectedValue="{Binding ClipboardTypeFilter, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  VerticalAlignment="Center"
                                  Margin="14,0,0,0">
                            <ComboBoxItem Content="全部类型" Tag="All" />
                            <ComboBoxItem Content="文本" Tag="Text" />
                            <ComboBoxItem Content="图片" Tag="Image" />
                            <ComboBoxItem Content="文件" Tag="File" />
                            <ComboBoxItem Content="链接" Tag="Link" />
                            <ComboBoxItem Content="颜色" Tag="Color" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Background="{StaticResource PanelInsetBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="剪贴板历史"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                        </Border>

                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding FilteredClipboardItems}"
                                     SelectedItem="{Binding SelectedClipboardEntry}"
                                     MouseDoubleClick="ClipboardList_MouseDoubleClick"
                                     Background="{StaticResource PanelInsetBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="74" Margin="14,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="38"
                                                    Height="38"
                                                    Background="#2D2D30"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center">
                                                <Grid ClipToBounds="True">
                                                    <TextBlock Text="▤"
                                                               FontSize="20"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Image Source="{Binding ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                                           Stretch="UniformToFill">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Column="1" Margin="0,0,14,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                </Grid.RowDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayText}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="{Binding KindTitle}"
                                                                   Style="{StaticResource ListMetaStyle}" />
                                                        <TextBlock Text=" · "
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="13" />
                                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                                   Style="{StaticResource ListMetaStyle}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border Grid.Row="1" Background="#3A3A3A" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="暂无记录"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilteredClipboardItems.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource BorderBrushSoft}" />

                    <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="72" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="24,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedClipboardEntry.DisplayText, TargetNullValue=剪贴板}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedClipboardEntry.KindTitle, TargetNullValue=未选择}"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Content="复制"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding CopySelectedClipboardCommand}" />
                                    <Button Content="删除"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding DeleteSelectedClipboardCommand}"
                                            Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="24">
                            <Border Background="{StaticResource PanelInsetBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <TextBox Text="{Binding SelectedClipboardEntry.Content}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="17"
                                         Padding="18"
                                         VerticalContentAlignment="Top">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedClipboardEntry}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedClipboardEntry.Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>

                            <Border Background="{StaticResource PanelInsetBrush}"
                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedClipboardEntry.Kind}" Value="{x:Static models:ClipboardItemKind.Image}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding SelectedClipboardEntry.ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                       Stretch="Uniform"
                                       Margin="18" />
                            </Border>

                            <TextBlock Text="未选择项目"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedClipboardEntry}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NotesTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource WindowChromeBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="记事本"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedNote.Title, TargetNullValue=未选择记事}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="480" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <ToggleButton x:Name="NotesHistoryButton"
                                          Content="历史记事"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          Margin="0,0,8,0" />
                            <TextBlock Text="字号"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBox Text="{Binding NoteFontSizeText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="54"
                                     Height="32"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     TextAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     Margin="0,0,8,0" />
                            <Button Content="+  新建"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding AddNoteCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="删除"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding DeleteSelectedNoteCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="0" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Popup x:Name="NotesHistoryPopup"
                           PlacementTarget="{Binding ElementName=NotesHistoryButton}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           IsOpen="{Binding IsChecked, ElementName=NotesHistoryButton, Mode=TwoWay}">
                        <Border Width="380"
                                Height="480"
                                Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                                        BorderThickness="0,0,0,1"
                                        Background="{StaticResource WindowChromeBrush}">
                                    <Grid Margin="16,0">
                                        <TextBox Text="{Binding NoteQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38"
                                                 FontSize="15"
                                                 Padding="12,0"
                                                 VerticalContentAlignment="Center" />
                                        <TextBlock Text="搜索记事"
                                                   FontSize="15"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="13,0,0,0"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoteQuery}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding FilteredNotes}"
                                         SelectedItem="{Binding SelectedNote}"
                                         SelectionChanged="NotesHistoryList_SelectionChanged"
                                         Tag="{Binding ElementName=NotesHistoryPopup}"
                                         Background="{StaticResource PanelBrush}"
                                         BorderThickness="0"
                                         Padding="0,8,0,12">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="66" Margin="16,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="1" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center"
                                                                Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Body}"
                                                                   Style="{StaticResource ListMetaStyle}"
                                                                   MaxHeight="18"
                                                                   Margin="0,4,0,0" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                               Style="{StaticResource ListMetaStyle}"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                                <Border Grid.Row="1" Background="#383838" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Popup>

                    <Grid Background="{StaticResource PanelInsetBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="112" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="18,16,18,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="38" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBox Text="{Binding NewNoteTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         FontSize="15"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="新记事标题"
                                           FontSize="15"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="13,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewNoteTitle}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Grid.Row="2">
                                <TextBox Text="{Binding NoteQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         FontSize="15"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="搜索记事"
                                           FontSize="15"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="13,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoteQuery}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding FilteredNotes}"
                                 SelectedItem="{Binding SelectedNote}"
                                 Background="{StaticResource PanelInsetBrush}"
                                 BorderThickness="0"
                                 Padding="0,4,0,14">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="68" Margin="18,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center"
                                                    Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Body}"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       MaxHeight="18"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding UpdatedAt, StringFormat={}{0:MM-dd HH:mm}}"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   VerticalAlignment="Center" />
                                        <Border Height="1"
                                                Background="#3A3A3A"
                                                VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource BorderBrushSoft}" />

                    <Grid Grid.Column="2">
                        <Grid Margin="46,34,46,40">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNote}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>
                            <TextBox Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="28"
                                     FontWeight="SemiBold"
                                     Padding="0"
                                     VerticalContentAlignment="Center" />
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ListBox ItemsSource="{Binding SelectedNote.Images}"
                                         SelectedItem="{Binding SelectedNoteImage}"
                                         Height="92"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedNote.Images.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="118"
                                                    Height="86"
                                                    Background="{StaticResource PanelInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                                       Stretch="Uniform"
                                                       Margin="5" />
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Grid.Column="1"
                                        Content="粘贴图片"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding AddNoteImageFromClipboardCommand}"
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Top" />
                                <Button Grid.Column="2"
                                        Content="添加图片"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding AddNoteImageFromFileCommand}"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Top" />
                                <Button Grid.Column="3"
                                        Content="删除图片"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding DeleteSelectedNoteImageCommand}"
                                        VerticalAlignment="Top" />
                            </Grid>
                            <TextBox Grid.Row="4"
                                     Text="{Binding SelectedNote.Body, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="{Binding NoteFontSize}"
                                     Padding="0"
                                     VerticalContentAlignment="Top" />
                            <TextBlock Grid.Row="5"
                                       Text="{Binding SelectedNote.UpdatedAt, StringFormat=最后更新 {0:yyyy-MM-dd HH:mm}}"
                                       Style="{StaticResource ListMetaStyle}"
                                       VerticalAlignment="Bottom" />
                        </Grid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedNote}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="还没有选择记事"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="点击新建开始记录"
                                       Style="{StaticResource ListMetaStyle}"
                                       FontSize="15"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlansTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource WindowChromeBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="计划管理表"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedPlan.Title, TargetNullValue=未选择计划}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="+ 新计划"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding AddPlanCommand}"
                                    Margin="0,0,8,0" />
                            <Button Command="{Binding TogglePlanEditorCommand}"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                                        <Setter Property="Content" Value="编辑" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlanEditorOpen}" Value="True">
                                                <Setter Property="Content" Value="收起编辑" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="完成"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding CompleteSelectedPlanCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="删除"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding DeleteSelectedPlanCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="396" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Background="{StaticResource PanelInsetBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="14,12,14,10">
                            <Grid>
                                <TextBox Text="{Binding NewPlanTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34"
                                         FontSize="14"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="输入计划标题后点右上角新建"
                                           FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="11,0,0,0"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewPlanTitle}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="108" />
                                    <ColumnDefinition Width="108" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox Text="{Binding PlanQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Height="34"
                                             FontSize="14"
                                             Padding="10,0"
                                             VerticalContentAlignment="Center" />
                                    <TextBlock Text="搜索计划"
                                               FontSize="14"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="11,0,0,0"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlanQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <ComboBox Grid.Column="1"
                                          Height="34"
                                          SelectedValue="{Binding PlanStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          Margin="8,0,0,0">
                                    <ComboBoxItem Content="全部状态" Tag="All" />
                                    <ComboBoxItem Content="未开始" Tag="NotStarted" />
                                    <ComboBoxItem Content="进行中" Tag="InProgress" />
                                    <ComboBoxItem Content="已完成" Tag="Completed" />
                                    <ComboBoxItem Content="已阻塞" Tag="Blocked" />
                                </ComboBox>
                                <ComboBox Grid.Column="2"
                                          Height="34"
                                          SelectedValue="{Binding PlanPriorityFilter, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          Margin="8,0,0,0">
                                    <ComboBoxItem Content="全部优先级" Tag="All" />
                                    <ComboBoxItem Content="高优先级" Tag="High" />
                                    <ComboBoxItem Content="中优先级" Tag="Medium" />
                                    <ComboBoxItem Content="低优先级" Tag="Low" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource CardStyle}" Margin="0,0,4,0" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="全部"
                                                   Style="{StaticResource ListMetaStyle}" />
                                        <TextBlock Text="{Binding PlanTotalCount}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="4,0" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="待完成"
                                                   Style="{StaticResource ListMetaStyle}" />
                                        <TextBlock Text="{Binding PlanPendingCount}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="4,0" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="已完成"
                                                   Style="{StaticResource ListMetaStyle}" />
                                        <TextBlock Text="{Binding PlanCompletedCount}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Margin="4,0,0,0" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="已逾期"
                                                   Style="{StaticResource ListMetaStyle}" />
                                        <TextBlock Text="{Binding PlanOverdueCount}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="14,0,14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="74" />
                                <ColumnDefinition Width="126" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="计划"
                                       Style="{StaticResource ListMetaStyle}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="状态"
                                       Style="{StaticResource ListMetaStyle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Text="优先级"
                                       Style="{StaticResource ListMetaStyle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="计划完成时间"
                                       Style="{StaticResource ListMetaStyle}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="2">
                            <ListBox ItemsSource="{Binding FilteredPlans}"
                                     SelectedItem="{Binding SelectedPlan}"
                                     Background="{StaticResource PanelInsetBrush}"
                                     BorderThickness="0"
                                     Padding="0,2,0,8">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="58" Margin="14,0,14,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="126" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding StartAtText, StringFormat=开始时间 {0}}"
                                                           Style="{StaticResource ListMetaStyle}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusText}"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding PriorityText}"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TargetCompletedAtText}"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.ColumnSpan="4"
                                                    Height="1"
                                                    Background="#343434"
                                                    VerticalAlignment="Bottom" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="还没有计划项目"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="15"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FilteredPlans.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>

                    <Border Grid.Column="1" Background="{StaticResource BorderBrushSoft}" />

                    <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
                        <Grid Margin="22,20,22,22">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPlan}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedPlan.Title}"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedPlan.SummaryText}"
                                               Style="{StaticResource ListMetaStyle}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top">
                                    <Border Style="{StaticResource CardStyle}" Padding="10,6" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedPlan.StatusText}"
                                                   Style="{StaticResource ListMetaStyle}" />
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="10,6">
                                        <TextBlock Text="{Binding SelectedPlan.PriorityText}"
                                                   Style="{StaticResource ListMetaStyle}" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2"
                                    Background="{StaticResource PanelInsetBrush}"
                                    Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlanEditorOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="计划详情默认关闭，点击上方“编辑”打开。"
                                               Style="{StaticResource ListMetaStyle}"
                                               Margin="0,0,0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource CardStyle}" Margin="0,0,6,0" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="开始时间"
                                                           Style="{StaticResource ListMetaStyle}" />
                                                <TextBlock Text="{Binding SelectedPlan.StartAtText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="计划完成时间"
                                                           Style="{StaticResource ListMetaStyle}" />
                                                <TextBlock Text="{Binding SelectedPlan.TargetCompletedAtText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="6,0,0,0" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="实际完成时间"
                                                           Style="{StaticResource ListMetaStyle}" />
                                                <TextBlock Text="{Binding SelectedPlan.ActualCompletedAtText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="0,12,0,0"
                                            Padding="14,12">
                                        <StackPanel>
                                            <TextBlock Text="计划说明"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedPlan.SummaryText}"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="计划图片"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   FontWeight="SemiBold" />
                                        <ListBox ItemsSource="{Binding SelectedPlan.Images}"
                                                 SelectedItem="{Binding SelectedPlanImage}"
                                                 Height="92"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 Margin="0,8,0,0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPlan.Images.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="118"
                                                            Height="86"
                                                            Background="{StaticResource PanelInsetBrush}"
                                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="0,0,10,0">
                                                        <Image Source="{Binding ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                                               Stretch="Uniform"
                                                               Margin="5" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto">
                                <ScrollViewer.Style>
                                    <Style TargetType="ScrollViewer">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlanEditorOpen}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Style>
                                <StackPanel>
                                    <TextBox Text="{Binding SelectedPlan.Title, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             FontSize="24"
                                             FontWeight="SemiBold"
                                             Padding="0"
                                             VerticalContentAlignment="Center" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="状态"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       FontWeight="SemiBold" />
                                            <ComboBox Margin="0,8,8,0"
                                                      Height="36"
                                                      SelectedValue="{Binding SelectedPlanStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag">
                                                <ComboBoxItem Content="未开始" Tag="{x:Static models:PlanItemStatus.NotStarted}" />
                                                <ComboBoxItem Content="进行中" Tag="{x:Static models:PlanItemStatus.InProgress}" />
                                                <ComboBoxItem Content="已完成" Tag="{x:Static models:PlanItemStatus.Completed}" />
                                                <ComboBoxItem Content="已阻塞" Tag="{x:Static models:PlanItemStatus.Blocked}" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="优先级"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       FontWeight="SemiBold" />
                                            <ComboBox Margin="8,8,0,0"
                                                      Height="36"
                                                      SelectedValue="{Binding SelectedPlanPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="Tag">
                                                <ComboBoxItem Content="高" Tag="{x:Static models:PlanPriority.High}" />
                                                <ComboBoxItem Content="中" Tag="{x:Static models:PlanPriority.Medium}" />
                                                <ComboBoxItem Content="低" Tag="{x:Static models:PlanPriority.Low}" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="开始时间"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   FontWeight="SemiBold" />
                                        <Border Style="{StaticResource CardStyle}"
                                                Background="{StaticResource PanelInsetBrush}"
                                                Margin="0,8,0,0"
                                                Padding="12,10">
                                            <TextBlock Text="{Binding SelectedPlan.StartAtText}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="计划完成时间"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   FontWeight="SemiBold" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="148" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <DatePicker x:Name="TargetCompletedDatePicker"
                                                        SelectedDate="{Binding SelectedPlanTargetCompletedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{StaticResource PlanDatePickerStyle}"
                                                        SelectedDateFormat="Short"
                                                        VerticalContentAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource PlanTimeComboBoxStyle}"
                                                      ItemsSource="{Binding PlanTimeOptions}"
                                                      Text="{Binding SelectedPlanTargetCompletedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      Margin="8,0,0,0"
                                                      VerticalContentAlignment="Center" />
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource CardStyle}"
                                                    Background="{StaticResource PanelInsetBrush}"
                                                    Margin="8,0,0,0"
                                                    Padding="10,0"
                                                    Width="148">
                                                <TextBlock Text="{Binding SelectedPlan.TargetCompletedAtText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button Grid.Column="3"
                                                    Content="清空"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    Command="{Binding ClearSelectedPlanTargetCompletedAtCommand}"
                                                    Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="实际完成时间"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   FontWeight="SemiBold" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="148" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <DatePicker x:Name="ActualCompletedDatePicker"
                                                        SelectedDate="{Binding SelectedPlanActualCompletedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{StaticResource PlanDatePickerStyle}"
                                                        SelectedDateFormat="Short"
                                                        VerticalContentAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource PlanTimeComboBoxStyle}"
                                                      ItemsSource="{Binding PlanTimeOptions}"
                                                      Text="{Binding SelectedPlanActualCompletedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      Margin="8,0,0,0"
                                                      VerticalContentAlignment="Center" />
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource CardStyle}"
                                                    Background="{StaticResource PanelInsetBrush}"
                                                    Margin="8,0,0,0"
                                                    Padding="10,0"
                                                    Width="148">
                                                <TextBlock Text="{Binding SelectedPlan.ActualCompletedAtText}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal"
                                                        Margin="8,0,0,0">
                                                <Button Content="标记完成"
                                                        Style="{StaticResource ToolbarButtonStyle}"
                                                        Command="{Binding CompleteSelectedPlanCommand}"
                                                        Margin="0,0,6,0" />
                                                <Button Content="清空"
                                                        Style="{StaticResource ToolbarButtonStyle}"
                                                        Command="{Binding ClearSelectedPlanActualCompletedAtCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="计划说明"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   FontWeight="SemiBold" />
                                        <TextBox Text="{Binding SelectedPlan.Description, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 MinHeight="140"
                                                 Margin="0,8,0,0"
                                                 VerticalContentAlignment="Top" />
                                    </StackPanel>

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ListBox ItemsSource="{Binding SelectedPlan.Images}"
                                                 SelectedItem="{Binding SelectedPlanImage}"
                                                 Height="92"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                            <ListBox.Style>
                                                <Style TargetType="ListBox">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedPlan.Images.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.Style>
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="118"
                                                            Height="86"
                                                            Background="{StaticResource PanelInsetBrush}"
                                                            BorderBrush="{StaticResource BorderBrushSoft}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Margin="0,0,10,0">
                                                        <Image Source="{Binding ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                                               Stretch="Uniform"
                                                               Margin="5" />
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <Button Grid.Column="1"
                                                Content="粘贴图片"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Command="{Binding AddPlanImageFromClipboardCommand}"
                                                Margin="12,0,8,0"
                                                VerticalAlignment="Top" />
                                        <Button Grid.Column="2"
                                                Content="添加图片"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Command="{Binding AddPlanImageFromFileCommand}"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Top" />
                                        <Button Grid.Column="3"
                                                Content="删除图片"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Command="{Binding DeleteSelectedPlanImageCommand}"
                                                VerticalAlignment="Top" />
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock Grid.Row="4"
                                       Text="{Binding SelectedPlan.UpdatedAt, StringFormat=最后更新：{0:yyyy-MM-dd HH:mm}}"
                                       Style="{StaticResource ListMetaStyle}"
                                       VerticalAlignment="Bottom" />
                        </Grid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedPlan}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="还没有选中计划"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="从左侧列表选择一项，或者新建一个计划开始管理。"
                                       Style="{StaticResource ListMetaStyle}"
                                       FontSize="14"
                                       Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlansCalendarTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource PlanCalendarScrollBar}" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{StaticResource WindowChromeBrush}"
                        BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日程表"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding PlanCalendarMonthTitle}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="+ 新计划"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding AddPlanCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="上个月"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ShowPreviousPlanMonthCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="今天"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ShowCurrentPlanMonthCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="下个月"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ShowNextPlanMonthCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="×"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1"
                      Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="432" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#16212C"
                            BorderBrush="#243244"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="SCHEDULE CALENDAR"
                                               Foreground="#D2A06D"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PlanCalendarMonthTitle}"
                                               FontSize="26"
                                               FontWeight="Bold"
                                               Margin="0,8,0,0" />
                                    <TextBlock Text="在月历上查看每一天的安排，点击右侧继续编辑。"
                                               Style="{StaticResource ListMetaStyle}"
                                               Foreground="#8FA0B5"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="#1A2A3A"
                                        BorderBrush="#243244"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="10,7"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Top">
                                    <StackPanel>
                                        <TextBlock Text="总计划"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   Foreground="#8FA0B5"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding PlanTotalCount}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.25*" />
                                    <ColumnDefinition Width="126" />
                                    <ColumnDefinition Width="126" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PlanQuery, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         FontSize="14"
                                         Padding="12,0"
                                         Background="#182635"
                                         BorderBrush="#243244"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          Height="36"
                                          SelectedValue="{Binding PlanStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          Margin="10,0,0,0">
                                    <ComboBoxItem Content="全部状态" Tag="All" />
                                    <ComboBoxItem Content="未开始" Tag="NotStarted" />
                                    <ComboBoxItem Content="进行中" Tag="InProgress" />
                                    <ComboBoxItem Content="已完成" Tag="Completed" />
                                    <ComboBoxItem Content="已阻塞" Tag="Blocked" />
                                </ComboBox>
                                <ComboBox Grid.Column="2"
                                          Height="36"
                                          SelectedValue="{Binding PlanPriorityFilter, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Tag"
                                          Margin="10,0,0,0">
                                    <ComboBoxItem Content="全部优先级" Tag="All" />
                                    <ComboBoxItem Content="高优先级" Tag="High" />
                                    <ComboBoxItem Content="中优先级" Tag="Medium" />
                                    <ComboBoxItem Content="低优先级" Tag="Low" />
                                </ComboBox>
                                <TextBox Grid.Column="3"
                                         Text="{Binding NewPlanTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         FontSize="14"
                                         Padding="12,0"
                                         Margin="10,0,0,0"
                                         Background="#182635"
                                         BorderBrush="#243244"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="8,22,8,14"
                                  Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="一" HorizontalAlignment="Center" Foreground="#8490A0" />
                                <TextBlock Grid.Column="1" Text="二" HorizontalAlignment="Center" Foreground="#8490A0" />
                                <TextBlock Grid.Column="2" Text="三" HorizontalAlignment="Center" Foreground="#8490A0" />
                                <TextBlock Grid.Column="3" Text="四" HorizontalAlignment="Center" Foreground="#8490A0" />
                                <TextBlock Grid.Column="4" Text="五" HorizontalAlignment="Center" Foreground="#8490A0" />
                                <TextBlock Grid.Column="5" Text="六" HorizontalAlignment="Center" Foreground="#8490A0" />
                                <TextBlock Grid.Column="6" Text="日" HorizontalAlignment="Center" Foreground="#8490A0" />
                            </Grid>

                            <Grid Grid.Row="2"
                                  Margin="6,18,6,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="一" HorizontalAlignment="Center" Foreground="#D8E0EA" FontSize="15" />
                                <TextBlock Grid.Column="1" Text="二" HorizontalAlignment="Center" Foreground="#D8E0EA" FontSize="15" />
                                <TextBlock Grid.Column="2" Text="三" HorizontalAlignment="Center" Foreground="#D8E0EA" FontSize="15" />
                                <TextBlock Grid.Column="3" Text="四" HorizontalAlignment="Center" Foreground="#D8E0EA" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="4" Text="五" HorizontalAlignment="Center" Foreground="#D8E0EA" FontSize="15" />
                                <TextBlock Grid.Column="5" Text="六" HorizontalAlignment="Center" Foreground="#D8E0EA" FontSize="15" />
                                <TextBlock Grid.Column="6" Text="日" HorizontalAlignment="Center" Foreground="#D8E0EA" FontSize="15" />
                            </Grid>

                            <ItemsControl Grid.Row="3"
                                          Margin="0,2,0,0"
                                          ItemsSource="{Binding PlanCalendarDays}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectPlanCalendarDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="1,3"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Grid MinHeight="70">
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Top">
                                                    <Grid Width="44"
                                                          Height="44">
                                                        <Ellipse Width="44"
                                                                 Height="44"
                                                                 Fill="#36B8F1">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding DayText}"
                                                                   FontSize="17"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#F4F7FB" />
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                            <Setter Property="Foreground" Value="#6D7480" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="#10202B" />
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Ellipse Width="5"
                                                                 Height="5"
                                                                 Fill="#E1B34B"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Margin="0,7,6,0"
                                                                 Visibility="{Binding HasPlans, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding SecondaryText}"
                                                               FontSize="10"
                                                               Margin="0,2,0,0"
                                                               HorizontalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#E8EDF4" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                        <Setter Property="Foreground" Value="#6D7480" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Foreground" Value="#67D2FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl Grid.Row="3"
                                          ItemsSource="{Binding PlanCalendarDays}"
                                          Visibility="Collapsed">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.SelectPlanCalendarDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="5"
                                                Padding="0"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Border MinHeight="78"
                                                    Padding="16,12,16,10">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#18293A" />
                                                        <Setter Property="BorderBrush" Value="#243244" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="CornerRadius" Value="16" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#272E39" />
                                                                <Setter Property="BorderBrush" Value="#C88752" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                <Setter Property="BorderBrush" Value="#C88752" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                <Setter Property="Background" Value="#142230" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBlock Text="{Binding DayText}"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                                        <Setter Property="Foreground" Value="#697486" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Ellipse Width="8"
                                                             Height="8"
                                                             Fill="#D89253"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Bottom"
                                                             Margin="0,0,0,4"
                                                             Visibility="{Binding HasPlans, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Width="432"
                            Background="#16212C"
                            BorderBrush="#243244"
                            BorderThickness="1"
                            CornerRadius="18"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DAY DETAIL"
                                           Foreground="#D2A06D"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Background="#1B2A3A"
                                        BorderBrush="#243244"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="10,6"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding SelectedPlanDateCount, StringFormat={}{0}条安排}"
                                               FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding SelectedPlanDateTitle}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          Style="{StaticResource PlanCalendarScrollViewer}"
                                          Margin="0,14,0,0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Border Background="#142230"
                                            BorderBrush="#243244"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="14"
                                            Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="当日安排"
                                                       Foreground="#D2A06D"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <Grid Grid.Row="1"
                                                  Margin="0,12,0,0">
                                                <ItemsControl ItemsSource="{Binding SelectedPlanDayDetails}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Margin="0,0,0,12"
                                                                    Padding="12,8">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#192837" />
                                                                        <Setter Property="BorderBrush" Value="#243244" />
                                                                        <Setter Property="BorderThickness" Value="1" />
                                                                        <Setter Property="CornerRadius" Value="16" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="#262E39" />
                                                                                <Setter Property="BorderBrush" Value="#C88752" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0"
                                                                            Command="{Binding DataContext.SelectPlanDayDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            Padding="0"
                                                                            HorizontalContentAlignment="Stretch"
                                                                            VerticalContentAlignment="Center"
                                                                            Background="Transparent"
                                                                            BorderThickness="0">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Plan.Title}"
                                                                                           FontSize="14"
                                                                                           FontWeight="Bold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           Margin="0,0,14,0" />
                                                                                <WrapPanel Margin="0,6,0,0">
                                                                                    <Border CornerRadius="999"
                                                                                            Padding="7,2"
                                                                                            Margin="0,0,6,0"
                                                                                            BorderThickness="1">
                                                                                        <Border.Style>
                                                                                            <Style TargetType="Border">
                                                                                                <Setter Property="Background" Value="#17293A" />
                                                                                                <Setter Property="BorderBrush" Value="#2D4760" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Overdue">
                                                                                                        <Setter Property="Background" Value="#34171D" />
                                                                                                        <Setter Property="BorderBrush" Value="#5B2A34" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Completed">
                                                                                                        <Setter Property="Background" Value="#12281B" />
                                                                                                        <Setter Property="BorderBrush" Value="#1F5132" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding StatusKind}" Value="Blocked">
                                                                                                        <Setter Property="Background" Value="#352610" />
                                                                                                        <Setter Property="BorderBrush" Value="#6A4619" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Border.Style>
                                                                                        <TextBlock Text="{Binding TagText}"
                                                                                                   FontSize="12"
                                                                                                   FontWeight="SemiBold">
                                                                                            <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                    <Setter Property="Foreground" Value="#8CCAF8" />
                                                                                                    <Style.Triggers>
                                                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Overdue">
                                                                                                            <Setter Property="Foreground" Value="#FF91A2" />
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Completed">
                                                                                                            <Setter Property="Foreground" Value="#80E0AA" />
                                                                                                        </DataTrigger>
                                                                                                        <DataTrigger Binding="{Binding StatusKind}" Value="Blocked">
                                                                                                            <Setter Property="Foreground" Value="#F3B86A" />
                                                                                                        </DataTrigger>
                                                                                                    </Style.Triggers>
                                                                                                </Style>
                                                                                            </TextBlock.Style>
                                                                                        </TextBlock>
                                                                                    </Border>
                                                                                    <Border Background="#223243"
                                                                                            BorderBrush="#2E4054"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="999"
                                                                                            Padding="7,2"
                                                                                            Margin="0,0,6,0">
                                                                                        <TextBlock Text="{Binding TimeText}"
                                                                                                   Foreground="#E5EDF5"
                                                                                                   FontSize="12"
                                                                                                   FontWeight="SemiBold" />
                                                                                    </Border>
                                                                                    <Border Background="#223243"
                                                                                            BorderBrush="#2E4054"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="999"
                                                                                            Padding="7,2">
                                                                                        <TextBlock Text="{Binding PriorityText}"
                                                                                                   Foreground="#E5EDF5"
                                                                                                   FontSize="12"
                                                                                                   FontWeight="SemiBold" />
                                                                                    </Border>
                                                                                </WrapPanel>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="1"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Center"
                                                                                        Margin="8,0,0,0">
                                                                                <Border CornerRadius="999"
                                                                                        Padding="9,3"
                                                                                        BorderThickness="1"
                                                                                        Margin="0">
                                                                                    <Border.Style>
                                                                                        <Style TargetType="Border">
                                                                                            <Setter Property="Background" Value="#1C2A38" />
                                                                                            <Setter Property="BorderBrush" Value="#324252" />
                                                                                            <Style.Triggers>
                                                                                                <DataTrigger Binding="{Binding PlanStatusKind}" Value="InProgress">
                                                                                                    <Setter Property="Background" Value="#17293A" />
                                                                                                    <Setter Property="BorderBrush" Value="#2D4760" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding PlanStatusKind}" Value="Completed">
                                                                                                    <Setter Property="Background" Value="#12281B" />
                                                                                                    <Setter Property="BorderBrush" Value="#1F5132" />
                                                                                                </DataTrigger>
                                                                                                <DataTrigger Binding="{Binding PlanStatusKind}" Value="Blocked">
                                                                                                    <Setter Property="Background" Value="#352610" />
                                                                                                    <Setter Property="BorderBrush" Value="#6A4619" />
                                                                                                </DataTrigger>
                                                                                            </Style.Triggers>
                                                                                        </Style>
                                                                                    </Border.Style>
                                                                                    <TextBlock Text="{Binding StatusText}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="#CBD4DE" />
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding PlanStatusKind}" Value="InProgress">
                                                                                                        <Setter Property="Foreground" Value="#8CCAF8" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding PlanStatusKind}" Value="Completed">
                                                                                                        <Setter Property="Foreground" Value="#80E0AA" />
                                                                                                    </DataTrigger>
                                                                                                    <DataTrigger Binding="{Binding PlanStatusKind}" Value="Blocked">
                                                                                                        <Setter Property="Foreground" Value="#F3B86A" />
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Button>
                                                                    <Button Grid.Column="1"
                                                                            Content="编辑"
                                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                                            Command="{Binding DataContext.OpenPlanDayDetailEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            MinWidth="60"
                                                                            Height="26"
                                                                            Margin="10,0,0,0"
                                                                            VerticalAlignment="Top" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,12,0,4">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedPlanDateCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="这一天还没有安排"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="可以新建一个计划，或者切换到其他日期查看。"
                                                               Style="{StaticResource ListMetaStyle}"
                                                               FontSize="14"
                                                               Margin="0,8,0,0"
                                                               HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <Border Background="#14202B"
                                            BorderBrush="#243244"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="16"
                                            Visibility="Collapsed">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedPlan.Title, TargetNullValue=未选择计划}"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <Button Content="完成"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            Command="{Binding CompleteSelectedPlanCommand}"
                                                            Margin="0,0,8,0" />
                                                    <ToggleButton IsChecked="{Binding IsPlanEditorOpen, Mode=TwoWay}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton"
                                                                   BasedOn="{StaticResource ToolbarToggleButtonStyle}">
                                                                <Setter Property="MinWidth" Value="92" />
                                                                <Setter Property="Background" Value="#17314A" />
                                                                <Setter Property="BorderBrush" Value="#2A4D6B" />
                                                                <Setter Property="Content" Value="收起编辑" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlanEditorOpen}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedPlan}" Value="{x:Null}">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,14,0,0">
                                                <Border Background="#182635"
                                                        BorderBrush="#243244"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="12">
                                                    <TextBlock Text="{Binding SelectedPlan.SummaryText, TargetNullValue=先从上面的日程卡片里选中一个计划，再点编辑。}"
                                                               Style="{StaticResource ListMetaStyle}"
                                                               Foreground="#D3D8DE"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <WrapPanel Margin="0,12,0,0">
                                                    <WrapPanel.Style>
                                                        <Style TargetType="WrapPanel">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedPlan}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </WrapPanel.Style>
                                                    <Border Background="#182635"
                                                            BorderBrush="#243244"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,10"
                                                            Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="开始时间"
                                                                       Style="{StaticResource ListMetaStyle}"
                                                                       Foreground="#8FA0B5" />
                                                            <TextBlock Text="{Binding SelectedPlan.StartAtText, TargetNullValue=未设置}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#182635"
                                                            BorderBrush="#243244"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,10"
                                                            Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="计划完成"
                                                                       Style="{StaticResource ListMetaStyle}"
                                                                       Foreground="#8FA0B5" />
                                                            <TextBlock Text="{Binding SelectedPlan.TargetCompletedAtText, TargetNullValue=未设置}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Background="#182635"
                                                            BorderBrush="#243244"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,10"
                                                            Margin="0,0,10,10">
                                                        <StackPanel>
                                                            <TextBlock Text="实际完成"
                                                                       Style="{StaticResource ListMetaStyle}"
                                                                       Foreground="#8FA0B5" />
                                                            <TextBlock Text="{Binding SelectedPlan.ActualCompletedAtText, TargetNullValue=未完成}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2"
                                                        Margin="0,16,0,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlanEditorOpen}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="编辑详情"
                                                           Foreground="#D2A06D"
                                                           FontSize="13"
                                                           FontWeight="SemiBold" />
                                                <Grid Margin="0,12,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="状态"
                                                                   Style="{StaticResource ListMetaStyle}"
                                                                   FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource SegmentBoxStyle}"
                                                                Margin="0,8,8,0">
                                                            <UniformGrid Columns="4"
                                                                         Margin="2">
                                                                <RadioButton Content="未开始"
                                                                             GroupName="PlanStatusCalendar"
                                                                             Style="{StaticResource NavTabStyle}"
                                                                             Command="{Binding SetSelectedPlanStatusCommand}"
                                                                             CommandParameter="NotStarted"
                                                                             IsChecked="{Binding SelectedPlan.Status, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PlanItemStatus.NotStarted}}" />
                                                                <RadioButton Content="进行中"
                                                                             GroupName="PlanStatusCalendar"
                                                                             Style="{StaticResource NavTabStyle}"
                                                                             Command="{Binding SetSelectedPlanStatusCommand}"
                                                                             CommandParameter="InProgress"
                                                                             IsChecked="{Binding SelectedPlan.Status, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PlanItemStatus.InProgress}}" />
                                                                <RadioButton Content="已完成"
                                                                             GroupName="PlanStatusCalendar"
                                                                             Style="{StaticResource NavTabStyle}"
                                                                             Command="{Binding SetSelectedPlanStatusCommand}"
                                                                             CommandParameter="Completed"
                                                                             IsChecked="{Binding SelectedPlan.Status, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PlanItemStatus.Completed}}" />
                                                                <RadioButton Content="已阻塞"
                                                                             GroupName="PlanStatusCalendar"
                                                                             Style="{StaticResource NavTabStyle}"
                                                                             Command="{Binding SetSelectedPlanStatusCommand}"
                                                                             CommandParameter="Blocked"
                                                                             IsChecked="{Binding SelectedPlan.Status, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PlanItemStatus.Blocked}}" />
                                                            </UniformGrid>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="优先级"
                                                                   Style="{StaticResource ListMetaStyle}"
                                                                   FontWeight="SemiBold" />
                                                        <Border Style="{StaticResource SegmentBoxStyle}"
                                                                Margin="8,8,0,0">
                                                            <UniformGrid Columns="3"
                                                                         Margin="2">
                                                                <RadioButton Content="高"
                                                                             GroupName="PlanPriorityCalendar"
                                                                             Style="{StaticResource NavTabStyle}"
                                                                             Command="{Binding SetSelectedPlanPriorityCommand}"
                                                                             CommandParameter="High"
                                                                             IsChecked="{Binding SelectedPlan.Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PlanPriority.High}}" />
                                                                <RadioButton Content="中"
                                                                             GroupName="PlanPriorityCalendar"
                                                                             Style="{StaticResource NavTabStyle}"
                                                                             Command="{Binding SetSelectedPlanPriorityCommand}"
                                                                             CommandParameter="Medium"
                                                                             IsChecked="{Binding SelectedPlan.Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PlanPriority.Medium}}" />
                                                                <RadioButton Content="低"
                                                                             GroupName="PlanPriorityCalendar"
                                                                             Style="{StaticResource NavTabStyle}"
                                                                             Command="{Binding SetSelectedPlanPriorityCommand}"
                                                                             CommandParameter="Low"
                                                                             IsChecked="{Binding SelectedPlan.Priority, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:PlanPriority.Low}}" />
                                                            </UniformGrid>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="开始时间"
                                                           Style="{StaticResource ListMetaStyle}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,16,0,0" />
                                                <Border Style="{StaticResource CardStyle}"
                                                        Background="{StaticResource PanelInsetBrush}"
                                                        Margin="0,8,0,0"
                                                        Padding="12,10">
                                                    <TextBlock Text="{Binding SelectedPlan.StartAtText}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </Border>

                                                <TextBlock Text="计划完成时间"
                                                           Style="{StaticResource ListMetaStyle}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,16,0,0" />
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <DatePicker x:Name="TargetCompletedDatePicker"
                                                                SelectedDate="{Binding SelectedPlanTargetCompletedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Style="{StaticResource PlanDatePickerStyle}"
                                                                SelectedDateFormat="Short"
                                                                VerticalContentAlignment="Center" />
                                                    <ComboBox Grid.Column="1"
                                                              Style="{StaticResource PlanTimeComboBoxStyle}"
                                                              ItemsSource="{Binding PlanTimeOptions}"
                                                              Text="{Binding SelectedPlanTargetCompletedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="False"
                                                              Margin="8,0,0,0"
                                                              VerticalContentAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Content="清空"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            Command="{Binding ClearSelectedPlanTargetCompletedAtCommand}"
                                                            Margin="8,0,0,0"
                                                            HorizontalAlignment="Left" />
                                                </Grid>

                                                <TextBlock Text="实际完成时间"
                                                           Style="{StaticResource ListMetaStyle}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,16,0,0" />
                                                <Grid Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="116" />
                                                        <ColumnDefinition Width="96" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <DatePicker x:Name="ActualCompletedDatePicker"
                                                                SelectedDate="{Binding SelectedPlanActualCompletedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                Style="{StaticResource PlanDatePickerStyle}"
                                                                SelectedDateFormat="Short"
                                                                VerticalContentAlignment="Center" />
                                                    <ComboBox Grid.Column="1"
                                                              Style="{StaticResource PlanTimeComboBoxStyle}"
                                                              ItemsSource="{Binding PlanTimeOptions}"
                                                              Text="{Binding SelectedPlanActualCompletedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="True"
                                                              IsTextSearchEnabled="False"
                                                              Margin="8,0,0,0"
                                                              VerticalContentAlignment="Center" />
                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Margin="8,0,0,0">
                                                        <Button Content="标记完成"
                                                                Style="{StaticResource ToolbarButtonStyle}"
                                                                Command="{Binding CompleteSelectedPlanCommand}"
                                                                Margin="0,0,6,0" />
                                                        <Button Content="清空"
                                                                Style="{StaticResource ToolbarButtonStyle}"
                                                                Command="{Binding ClearSelectedPlanActualCompletedAtCommand}" />
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="计划说明"
                                                           Style="{StaticResource ListMetaStyle}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,16,0,0" />
                                                <TextBox Text="{Binding SelectedPlan.Description, UpdateSourceTrigger=PropertyChanged}"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"
                                                         MinHeight="128"
                                                         Margin="0,8,0,0"
                                                         Padding="12,10"
                                                         Background="#182635"
                                                         BorderBrush="#243244"
                                                         BorderThickness="1"
                                                         VerticalContentAlignment="Top" />

                                                <Grid Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ListBox ItemsSource="{Binding SelectedPlan.Images}"
                                                             SelectedItem="{Binding SelectedPlanImage}"
                                                             Height="104"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Padding="0"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                        <ListBox.Style>
                                                            <Style TargetType="ListBox">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedPlan.Images.Count}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ListBox.Style>
                                                        <ListBox.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ListBox.ItemsPanel>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="118"
                                                                        Height="98"
                                                                        Background="#182635"
                                                                        BorderBrush="#243244"
                                                                        BorderThickness="1"
                                                                        CornerRadius="10"
                                                                        Margin="0,0,10,0">
                                                                    <Image Source="{Binding ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                                                           Stretch="Uniform"
                                                                           Margin="5" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>
                                                    <Button Grid.Column="1"
                                                            Content="粘贴图片"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            Command="{Binding AddPlanImageFromClipboardCommand}"
                                                            Margin="12,0,8,0"
                                                            VerticalAlignment="Top" />
                                                    <Button Grid.Column="2"
                                                            Content="添加图片"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            Command="{Binding AddPlanImageFromFileCommand}"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Top" />
                                                    <Button Grid.Column="3"
                                                            Content="删除图片"
                                                            Style="{StaticResource ToolbarButtonStyle}"
                                                            Command="{Binding DeleteSelectedPlanImageCommand}"
                                                            VerticalAlignment="Top" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Grid Grid.ColumnSpan="3"
                          Panel.ZIndex="30">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlanEditorOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Button Background="#B0141C27"
                                BorderThickness="0"
                                Command="{Binding ClosePlanEditorCommand}" />
                        <ContentControl HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Template="{DynamicResource PlanEditorDialogTemplate}" />
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <ControlTemplate x:Key="PlanEditorDialogTemplate" TargetType="ContentControl">
            <Grid Width="760"
                  MaxHeight="640">
                <Border Background="#15202A"
                        BorderBrush="#2B3A4A"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="计划详情"
                                           Foreground="#D2A06D"
                                           FontSize="13"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedPlan.Title, TargetNullValue=未选择计划}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="完成"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding CompleteSelectedPlanCommand}"
                                        Margin="0,0,8,0" />
                                <ToggleButton IsChecked="{Binding IsPlanEditorOpen, Mode=TwoWay}">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton"
                                               BasedOn="{StaticResource ToolbarToggleButtonStyle}">
                                            <Setter Property="MinWidth" Value="92" />
                                            <Setter Property="Background" Value="#17314A" />
                                            <Setter Property="BorderBrush" Value="#2A4D6B" />
                                            <Setter Property="Content" Value="关闭" />
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource PlanCalendarScrollViewer}"
                                      Margin="0,18,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="状态"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   FontWeight="SemiBold" />
                                        <ComboBox Margin="0,8,8,0"
                                                  Height="36"
                                                  SelectedValue="{Binding SelectedPlanStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="未开始" Tag="{x:Static models:PlanItemStatus.NotStarted}" />
                                            <ComboBoxItem Content="进行中" Tag="{x:Static models:PlanItemStatus.InProgress}" />
                                            <ComboBoxItem Content="已完成" Tag="{x:Static models:PlanItemStatus.Completed}" />
                                            <ComboBoxItem Content="已阻塞" Tag="{x:Static models:PlanItemStatus.Blocked}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="优先级"
                                                   Style="{StaticResource ListMetaStyle}"
                                                   FontWeight="SemiBold" />
                                        <ComboBox Margin="8,8,0,0"
                                                  Height="36"
                                                  SelectedValue="{Binding SelectedPlanPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectedValuePath="Tag">
                                            <ComboBoxItem Content="高" Tag="{x:Static models:PlanPriority.High}" />
                                            <ComboBoxItem Content="中" Tag="{x:Static models:PlanPriority.Medium}" />
                                            <ComboBoxItem Content="低" Tag="{x:Static models:PlanPriority.Low}" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="开始时间"
                                           Style="{StaticResource ListMetaStyle}"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,0" />
                                <Border Style="{StaticResource CardStyle}"
                                        Background="{StaticResource PanelInsetBrush}"
                                        Margin="0,8,0,0"
                                        Padding="12,10">
                                    <TextBlock Text="{Binding SelectedPlan.StartAtText}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </Border>

                                <TextBlock Text="计划完成时间"
                                           Style="{StaticResource ListMetaStyle}"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="TargetCompletedDatePickerDialog"
                                                SelectedDate="{Binding SelectedPlanTargetCompletedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource PlanDatePickerStyle}"
                                                SelectedDateFormat="Short"
                                                VerticalContentAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource PlanTimeComboBoxStyle}"
                                              ItemsSource="{Binding PlanTimeOptions}"
                                              Text="{Binding SelectedPlanTargetCompletedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              Margin="8,0,0,0"
                                              VerticalContentAlignment="Center" />
                                    <Button Grid.Column="2"
                                            Content="清空"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding ClearSelectedPlanTargetCompletedAtCommand}"
                                            Margin="8,0,0,0"
                                            HorizontalAlignment="Left" />
                                </Grid>

                                <TextBlock Text="实际完成时间"
                                           Style="{StaticResource ListMetaStyle}"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,0" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="116" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="ActualCompletedDatePickerDialog"
                                                SelectedDate="{Binding SelectedPlanActualCompletedDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource PlanDatePickerStyle}"
                                                SelectedDateFormat="Short"
                                                VerticalContentAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource PlanTimeComboBoxStyle}"
                                              ItemsSource="{Binding PlanTimeOptions}"
                                              Text="{Binding SelectedPlanActualCompletedTimeText, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              Margin="8,0,0,0"
                                              VerticalContentAlignment="Center" />
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Margin="8,0,0,0">
                                        <Button Content="标记完成"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Command="{Binding CompleteSelectedPlanCommand}"
                                                Margin="0,0,6,0" />
                                        <Button Content="清空"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Command="{Binding ClearSelectedPlanActualCompletedAtCommand}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="计划说明"
                                           Style="{StaticResource ListMetaStyle}"
                                           FontWeight="SemiBold"
                                           Margin="0,16,0,0" />
                                <TextBox Text="{Binding SelectedPlan.Description, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="128"
                                         Margin="0,8,0,0"
                                         Padding="12,10"
                                         Background="#182635"
                                         BorderBrush="#243244"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Top" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding SelectedPlan.Images}"
                                             SelectedItem="{Binding SelectedPlanImage}"
                                             Height="104"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.Style>
                                            <Style TargetType="ListBox">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedPlan.Images.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ListBox.Style>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="118"
                                                        Height="98"
                                                        Background="#182635"
                                                        BorderBrush="#243244"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Margin="0,0,10,0">
                                                    <Image Source="{Binding ImageBytes, Converter={StaticResource ImageBytesToSourceConverter}}"
                                                           Stretch="Uniform"
                                                           Margin="5" />
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Grid.Column="1"
                                            Content="粘贴图片"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding AddPlanImageFromClipboardCommand}"
                                            Margin="12,0,8,0"
                                            VerticalAlignment="Top" />
                                    <Button Grid.Column="2"
                                            Content="添加图片"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding AddPlanImageFromFileCommand}"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Top" />
                                    <Button Grid.Column="3"
                                            Content="删除图片"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Command="{Binding DeleteSelectedPlanImageCommand}"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </ControlTemplate>

        <DataTemplate x:Key="SettingsTemplate">
            <Grid Background="{StaticResource PanelBrush}">
                <Grid.Resources>
                    <SolidColorBrush x:Key="SettingsTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFFFFF" />

                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                    </Style>

                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                    </Style>

                    <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                        <Setter Property="Background" Value="{StaticResource PanelInsetBrush}" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Root"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#3A3A3A" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectionBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <Style TargetType="ComboBox">
                        <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                        <Setter Property="Background" Value="#000000" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBox">
                                    <Grid SnapsToDevicePixels="True">
                                        <ToggleButton x:Name="ToggleButton"
                                                      Focusable="False"
                                                      ClickMode="Press"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Root"
                                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                            CornerRadius="4">
                                                        <TextBlock Text="⌄"
                                                                   Foreground="{StaticResource SettingsTextBrush}"
                                                                   FontSize="16"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,1" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Root" Property="BorderBrush" Value="#6A6A6A" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Root" Property="Background" Value="#080808" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <ContentPresenter Margin="10,0,30,0"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          IsHitTestVisible="False"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                                        <Popup x:Name="PART_Popup"
                                               Placement="Bottom"
                                               AllowsTransparency="True"
                                               Focusable="False"
                                               IsOpen="{TemplateBinding IsDropDownOpen}">
                                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Background="{StaticResource PanelInsetBrush}"
                                                    BorderBrush="{StaticResource BorderBrushSoft}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <ScrollViewer CanContentScroll="True"
                                                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.45" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{StaticResource BorderBrushSoft}"
                        BorderThickness="0,0,0,1">
                    <Border Style="{StaticResource SegmentBoxStyle}"
                            Width="390"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <UniformGrid Columns="2" Margin="2">
                            <RadioButton Content="设置"
                                         GroupName="SettingsSections"
                                         Style="{StaticResource NavTabStyle}"
                                         Foreground="{StaticResource SettingsTextBrush}"
                                         Command="{Binding ShowSettingsGeneralCommand}"
                                         IsChecked="{Binding SelectedSettingsPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:SettingsPage.General}}" />
                            <RadioButton Content="使用次数"
                                         GroupName="SettingsSections"
                                         Style="{StaticResource NavTabStyle}"
                                         Foreground="{StaticResource SettingsTextBrush}"
                                         Command="{Binding ShowUsageStatsCommand}"
                                         IsChecked="{Binding SelectedSettingsPage, Converter={StaticResource EnumEqualsConverter}, ConverterParameter={x:Static models:SettingsPage.Usage}}" />
                        </UniformGrid>
                    </Border>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="{x:Static models:SettingsPage.General}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel MaxWidth="860"
                                Margin="0,28,0,56">
                        <TextBlock Text="系统" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="86" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="98" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="开机自启"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                                <ToggleButton Grid.Column="1"
                                              Width="84"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToolbarToggleButtonStyle}"
                                              IsChecked="{Binding StartWithWindows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="关闭" />
                                                <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Text" Value="开启" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToggleButton>

                                <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <TextBlock Grid.Row="1"
                                           Text="启动后自动更新索引"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                                <ToggleButton Grid.Row="1"
                                              Grid.Column="1"
                                              Width="84"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToolbarToggleButtonStyle}"
                                              IsChecked="{Binding AutoScanOnDailyFirstLaunch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="关闭" />
                                                <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Text" Value="开启" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToggleButton>

                                <Border Grid.Row="2" Grid.ColumnSpan="4" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <TextBlock Grid.Row="2"
                                           Text="实时监控"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                                <ToggleButton Grid.Row="2"
                                              Grid.Column="1"
                                              Width="84"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToolbarToggleButtonStyle}"
                                              IsChecked="{Binding SystemMonitorEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="关闭" />
                                                <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Text" Value="开启" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToggleButton>

                                <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <TextBlock Grid.Row="3"
                                           Text="日志输出"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Margin="14,0,0,0" />
                                <ToggleButton Grid.Row="3"
                                              Grid.Column="1"
                                              Width="84"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToolbarToggleButtonStyle}"
                                              IsChecked="{Binding LoggingEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="关闭" />
                                                <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Text" Value="开启" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToggleButton>
                                <TextBox Grid.Row="3"
                                         Grid.Column="2"
                                         Height="34"
                                         VerticalAlignment="Center"
                                         Text="{Binding LogDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         IsEnabled="{Binding LoggingEnabled}" />
                                <Button Grid.Row="3"
                                        Grid.Column="3"
                                        Content="浏览"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding BrowseLogDirectoryCommand}"
                                        IsEnabled="{Binding LoggingEnabled}" />
                            </Grid>
                        </Border>

                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <ItemsControl ItemsSource="{Binding HotKeyEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="64">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="248" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="118" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Margin="14,0,0,0" />
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <ToggleButton Content="Ctrl"
                                                              Style="{StaticResource HotKeyToggleStyle}"
                                                              IsChecked="{Binding UseControl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ToggleButton Content="Alt"
                                                              Style="{StaticResource HotKeyToggleStyle}"
                                                              IsChecked="{Binding UseAlt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ToggleButton Content="Shift"
                                                              Style="{StaticResource HotKeyToggleStyle}"
                                                              IsChecked="{Binding UseShift, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <ToggleButton Content="Win"
                                                              Style="{StaticResource HotKeyToggleStyle}"
                                                              IsChecked="{Binding UseWin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <ComboBox Grid.Column="2"
                                                      ItemsSource="{Binding KeyOptions}"
                                                      SelectedItem="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Width="82"
                                                      VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Content="↻"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Command="{Binding ResetCommand}" />
                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding DisplayText}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="5"
                                                    Content="▣  打开"
                                                    Style="{StaticResource ToolbarButtonStyle}"
                                                    Command="{Binding OpenCommand}" />
                                            <Border Grid.ColumnSpan="6"
                                                    Height="1"
                                                    Background="#383838"
                                                    VerticalAlignment="Bottom"
                                                    Margin="14,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <TextBlock Text="导航" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="搜索源" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Border Grid.Column="1" Height="38" Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center" HorizontalAlignment="Left" Width="150">
                                    <TextBlock Text="内置索引" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Row="1" Grid.ColumnSpan="3" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <TextBlock Grid.Row="1" Text="硬盘索引" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Button Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Content="↻  重新扫描硬盘数据"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding RebuildFileIndexCommand}"
                                        HorizontalAlignment="Left" />
                                <Border Grid.Row="2" Grid.ColumnSpan="3" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <TextBlock Grid.Row="2" Text="缓存数据" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Button Grid.Row="2"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Content="清除导航缓存数据"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Command="{Binding ClearCacheDataCommand}"
                                        HorizontalAlignment="Left" />
                                <Border Grid.Row="3" Grid.ColumnSpan="3" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Button Grid.Row="3" Content="↻  刷新汇率" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshRatesCommand}" Margin="14,0,0,0" HorizontalAlignment="Left" />
                            </Grid>
                        </Border>

                        <TextBlock Text="剪贴板" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                    <RowDefinition Height="58" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="文本" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="1" Text="图片" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="2" Text="文件" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="3" Text="链接" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <TextBlock Grid.Row="4" Text="颜色" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />

                                <ComboBox Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>
                                <ComboBox Grid.Row="4" Grid.Column="1" SelectedIndex="0" Width="150" VerticalAlignment="Center">
                                    <ComboBoxItem Content="清除几天前" />
                                    <ComboBoxItem Content="保留最近" />
                                    <ComboBoxItem Content="手动" />
                                </ComboBox>

                                <TextBlock Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="30" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <TextBox Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="1" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="2" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="3" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />
                                <TextBox Grid.Row="4" Grid.Column="3" Text="30" Width="54" Height="34" TextAlignment="Center" FontSize="16" />

                                <TextBlock Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="4" Text="天" FontSize="17" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                <Border Grid.Row="1" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Border Grid.Row="2" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Border Grid.Row="3" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                                <Border Grid.Row="4" Grid.ColumnSpan="5" Height="1" Background="#383838" VerticalAlignment="Top" Margin="14,0" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSettingsPage}" Value="{x:Static models:SettingsPage.Usage}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="96" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="32,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="只显示使用次数大于 0 的应用"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SettingsTextBrush}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="🗑  清除使用次数"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Command="{Binding ClearUsageStatsCommand}"
                                    MinWidth="150"
                                    Height="36"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding UsageItems}"
                                 Background="{StaticResource PanelBrush}"
                                 BorderThickness="0"
                                 Padding="0,14,0,22"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="72" Margin="32,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="36"
                                                CornerRadius="7"
                                                Background="#202020"
                                                BorderBrush="{StaticResource BorderBrushSoft}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding Path, Converter={StaticResource FileIconToSourceConverter}}"
                                                   Width="30"
                                                   Height="30"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="17"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}"
                                                       Style="{StaticResource ListMetaStyle}"
                                                       Foreground="{StaticResource SettingsTextBrush}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}"
                                                       Foreground="{StaticResource SettingsTextBrush}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding LaunchCount, StringFormat={}{0} 次}"
                                                       Foreground="{StaticResource SettingsTextBrush}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Height="1"
                                                Background="#383838"
                                                VerticalAlignment="Bottom" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="还没有导航使用记录"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsageItems.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource WindowChromeBrush}"
                BorderBrush="#303030"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="RaycastPM"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#181818"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsIndexingFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Margin="18,8,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="7" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding IndexProgressText}"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,6" />
                <ProgressBar Grid.Row="1"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding IndexProgressValue, Mode=OneWay}"
                             Background="#2C2C2C"
                             Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:AppSection.Launcher}">
                                <Setter Property="ContentTemplate" Value="{StaticResource LauncherTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:AppSection.Clipboard}">
                                <Setter Property="ContentTemplate" Value="{StaticResource ClipboardTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:AppSection.Notes}">
                                <Setter Property="ContentTemplate" Value="{StaticResource NotesTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection}" Value="{x:Static models:AppSection.Plans}">
                                <Setter Property="ContentTemplate" Value="{StaticResource PlansCalendarTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Window>
