                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="关闭" />
                                                <Setter Property="Foreground" Value="{StaticResource SettingsTextBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Text" Value="开启" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                    <RowDefinition Height="64" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="118" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="导航" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0,0,0" />
                                <Border Grid.Column="1" Height="38" Background="{StaticResource PanelInsetBrush}" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="1" CornerRadius="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Settings.LauncherHotKey}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Button Grid.Column="2" Content="↻" Style="{StaticResource IconButtonStyle}" />
                                <Button Grid.Column="4" Content="▣  打开" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding ShowLauncherCommand}" />

